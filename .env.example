# TechHanu Production & Deployment Environment Configuration Example
# Copy this file to .env when using build scripts or local environments.
# NEVER commit actual secrets, API keys, or private spreadsheet IDs to source control.

# Google Apps Script Web App Endpoint for Enquiry Form
# Deployment format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwUbXAwKyz0qt1RutZGywTOA6uS_JSoJjTRcfYyJkR9GQC0QwMpK0B36S4Y3WG4wQc5/exec

# Target Google Sheet ID (Configured inside Code.gs on Google Apps Script)
# Extract from: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE
SHEET_NAME=Enquiries

# Canonical Domain and Contact Information
SITE_URL=https://techhanuorg.github.io/Techhanu/
CONTACT_EMAIL=techhanu.io@gmail.com
CONTACT_PHONE=+918470901434
WHATSAPP_NUMBER=918470901434
INSTAGRAM_HANDLE=techhanu.io
